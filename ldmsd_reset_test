#### helper functions #### -------------------------------------------

def ldmsd_request_send(dcont, cmd):
    """Send `cmd` to the ldmsd in `dcont`. Returns (rc, output)"""
    x = "/tada-src/python/ldmsd_request_send.py -x {xprt} -p {port} -H localhost --cmd '{cmd}'" \
        .format(xprt = LDMSD_XPRT, port = LDMSD_PORT, cmd = cmd)
    rc, out = dcont.exec_run(x)
    return (rc, out)

def query(dcont, cmd):
    """Send a stats|status request and return the JSON object of the reply"""
    rc, out = ldmsd_request_send(dcont, cmd)
    if rc:
        raise RuntimeError(f"'{cmd}' failed. rc: {rc}, out: {out.strip()}")
    return json.loads(out.strip())

def reset(dcont, cmd):
    """Send a reset request.

    Returns (rc, output). A reset request replies "OK" and no statistics.
    """
    rc, out = ldmsd_request_send(dcont, cmd)
    return (rc, out.strip())

def walk(obj):
    """Generate every dict and list nested in `obj` (including `obj`)"""
    yield obj
    if isinstance(obj, dict):
        for v in obj.values():
            yield from walk(v)
    elif isinstance(obj, list):
        for v in obj:
            yield from walk(v)

def values_of(obj, key):
    """Generate the values of `key` found at any depth of `obj`"""
    for o in walk(obj):
        if isinstance(o, dict) and key in o:
            yield o[key]

def reset_ok(rc_out):
    rc, out = rc_out
    return rc == 0 and out == "OK"

# -- extractors of the quantities that a reset must clear --

def xprt_op_count(js):
    return sum(v['count'] for v in js['op_stats'].values())

def thread_total_us(js):
    return sum(t['total_us'] for k in ('io_threads', 'worker_threads')
                             for t in js.get(k, []) if 'total_us' in t)

def update_count(js):
    return sum(values_of(js, "cnt"))

STORE_STAGES = ("io_thread", "decomp", "wait", "queue", "commit")

def store_count(js):
    # Each store stage reports the number of samples in its `count`.
    return sum(o[st]['count'] for o in walk(js) if isinstance(o, dict)
                              for st in STORE_STAGES
                              if isinstance(o.get(st), dict) and 'count' in o[st])

def stream_recv_count(js):
    return sum(v.get('recv', {}).get('count', 0) for k, v in js.items()
                if k != "_OVERALL_")

def profile_hop_count(js):
    # Number of profiled messages kept for the message channels
    return len(list(values_of(js.get('stream', {}), "hop_count")))

def msg_rx_count(js, tag = None):
    return sum(o['rx']['count'] for o in js if tag is None or o['msg_tag'] == tag)

def msg_client_tx_count(js):
    return sum(o['tx']['count'] for o in js)

def msg_client_drop_count(js):
    return sum(o['drops']['count'] for o in js)


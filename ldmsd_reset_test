def check_xprt():
    before = xprt_op_count(xprt0)
    r = reset(agg, "xprt_stats_reset")
    after_js = query(agg, "xprt_stats")
    after = xprt_op_count(after_js)
    passed = reset_ok(r) and before > 0 and after < before \
             and after_js['duration'] < xprt0['duration']
    return passed, f"reset: {r}, op count: {before} -> {after}, " \
                   f"duration: {xprt0['duration']} -> {after_js['duration']}"

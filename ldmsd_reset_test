# ===== the stats|status requests do not reset =====
def check_query_does_not_reset():
    # The deprecated `reset=true` attribute must have no effect on the queries.
    cmds = ["xprt_stats", "thread_stats", "profiling", "update_time_stats",
            "store_time_stats", "stream_status", "msg_stats json=1",
            "msg_client_stats json=1"]
    for c in cmds:
        ldmsd_request_send(agg, f"{c} reset=true")
    xprt1   = query(agg, "xprt_stats")
    thread1 = query(agg, "thread_stats")
    update1 = query(agg, "update_time_stats")
    store1  = query(agg, "store_time_stats")
    stream1 = query(agg, "stream_status")
    msg1    = query(agg, "msg_stats json=1")
    client1 = query(agg, "msg_client_stats json=1")
    # The counters never decrease unless they are reset.
    checks = {
        "xprt op count":     (xprt_op_count(xprt0), xprt_op_count(xprt1)),
        "thread total us":   (thread_total_us(thread0), thread_total_us(thread1)),
        "update count":      (update_count(update0), update_count(update1)),
        "store count":       (store_count(store0), store_count(store1)),
        "stream recv count": (stream_recv_count(stream0), stream_recv_count(stream1)),
        "msg rx count":      (msg_rx_count(msg0), msg_rx_count(msg1)),
        "client tx count":   (msg_client_tx_count(client0), msg_client_tx_count(client1)),
    }
    passed = all(b > 0 and a >= b for b, a in checks.values())
    return passed, ", ".join(f"{k}: {b} -> {a}" for k, (b, a) in checks.items())
check(QUERY_DOES_NOT_RESET, check_query_does_not_reset)

# ===== the deprecated attributes are logged =====
LDMSD_LOG = "/var/log/ldmsd.log"

def log_count(pattern):
    """Number of lines of the ldmsd log of `agg` that match `pattern`"""
    rc, out = agg.exec_run(f"grep -c -E '{pattern}' {LDMSD_LOG}")
    return int(out.strip() or 0)

def check_deprecated_attr_logged():
    # (request, the attribute to give, the reset request that the log suggests)
    cases = [("xprt_stats", "reset", "xprt_stats_reset"),
             ("xprt_stats", "hist_recalibrate", "xprt_stats_reset hist_recalibrate=true"),
             ("thread_stats", "reset", "thread_stats_reset"),
             ("profiling", "reset", "profiling_reset"),
             ("update_time_stats", "reset", "update_time_stats_reset"),
             ("store_time_stats", "reset", "store_time_stats_reset"),
             ("store_time_stats", "hist_recalibrate", "store_time_stats_reset hist_recalibrate=true"),
             ("stream_status", "reset", "stream_status_reset"),
             ("stream_client_dump", "reset", "stream_client_dump_reset"),
             ("msg_stats", "reset", "msg_stats_reset"),
             ("msg_client_stats", "reset", "msg_client_stats_reset")]
    missing = []
    for cmd, attr, suggest in cases:
        ldmsd_request_send(agg, f"{cmd} {attr}=true")
        # The log message has the quotes around the names. Match them with `.`.
        pat = f"{cmd}: the .{attr}. attribute is deprecated and ignored.*Use .{suggest}. to reset"
        if log_count(pat) < 1:
            missing.append(f"{cmd} {attr}")
    # reset=false must not be logged
    before = log_count("xprt_stats: the .reset. attribute")
    ldmsd_request_send(agg, "xprt_stats reset=false")
    after = log_count("xprt_stats: the .reset. attribute")
    if after != before:
        missing.append("xprt_stats reset=false was logged")
    return not missing, f"missing or unexpected log messages: {missing}" if missing \
                        else "all the expected messages are logged"
check(DEPRECATED_ATTR_LOGGED, check_deprecated_attr_logged)


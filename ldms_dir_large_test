def probe_update(kind, name, server_cmd):
    """Run `server_cmd` on the server, send the sentinel, and return how many
    `kind` updates of set `name` arrived"""
    m0 = int(pycmd(cli, "c2.mark()"))
    pycmd(srv, server_cmd)
    sent[0] += 1
    pycmd(srv, f"info('S0000000', 's', '{sent[0]}')")
    return int(slow(cli, f"c2.probe('{kind}', '{name}', 'S0000000', 1, {m0})"))


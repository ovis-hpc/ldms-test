def shape_for(delta, total_sets):
    """Make the entries of T and the fill sets total LIMIT + delta, and
    return the shape of the dir reply"""
    pycmd(srv, f"fit('{T}', {LIMIT + delta - N * E_FILL})")
    names = f"['{T}'] + [f'M{{i:07d}}' for i in range(1, {N + 1})]"
    EXPECT(pycmd(srv, f"total({names})"), str(LIMIT + delta))
    return slow(cli, f"c.shape({total_sets})")


def pycmd(tty, cmd, retry = 3, timeout_idle = 0.3):
    """cmd must be single command w/o new line"""
    sio = io.StringIO()
    tty.write(cmd)
    while tty.read() != '': # flush the echo
        continue
    tty.write("\n")
    count = 0
    end = False
    while count < retry and not end:
        o = tty.read(idle_timeout = timeout_idle)
        count = 0 if len(o) else count + 1
        sio.write(o)
        if sio.getvalue().endswith(">>> "):
            end = True
    if not end:
        raise RuntimeError("Python '{}' not responding".format(cmd))
    out = sio.getvalue()[2:-4].strip()
    if "Traceback (most recent call last)" in out:
        # an exception in the interactive helper: stop here with its text
        raise RuntimeError("Python '{}' failed:\n{}".format(cmd, out))
    return out

def slow(tty, cmd):
    """for commands that wait for several seconds"""
    return pycmd(tty, cmd, retry = 200) # up to ~60 s without output

def check(num, tty, cmd, expect, slow_cmd = False):
    """run `cmd` and assert the printed value equals `expect`"""
    out = slow(tty, cmd) if slow_cmd else pycmd(tty, cmd)
    test.assert_test(num, out == expect, f"cmd: {cmd}; expect: {expect}; got: {out}")
    return out

def check_in(num, tty, cmd, word):
    """run `cmd` and assert that `word` is in the printed value"""
    out = pycmd(tty, cmd)
    test.assert_test(num, word in out, f"cmd: {cmd}; expect '{word}' in: {out}")
    return out

def py_cmd(module):
    """Command of an interactive interpreter with `module` imported"""
    return "/bin/bash -c " + shlex.quote(
        '/usr/bin/python3 -i -c "import sys; '
        "sys.path.insert(0, '/tada-src/python'); "
        f'from {module} import *"')

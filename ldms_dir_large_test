# is not the owner of the sets. Sets with permission 0600 are skipped in its
# dir reply; sets with 0644 are listed.
slow(srv, "unpublish_all()")        # the 5,000 sets of the many-sets case
EXPECT(pycmd(srv, "listen_munge('/munge/dom1/sock')"), "True")
CMD7 = "/bin/bash -c " + shlex.quote(
    "su -m -s /bin/bash munge -c " + shlex.quote(
        '/usr/bin/python3 -i -c "import sys; '
        "sys.path.insert(0, '/tada-src/python'); "
        'from ldms_dir_client import *"'))
cli7 = node2.exec_interact(CMD7)
time.sleep(3)
EXPECT(cli7.read(), ">>> ")
pycmd(cli7, "c = Client(port=10001, auth='munge', "
            "auth_opts={'socket': '/munge/dom1/sock'})")
pycmd(cli7, "import os")
uid = pycmd(cli7, "os.getuid()")
listed = slow(cli7, "c.listed()")
test.assert_test(38, uid != "0" and listed == "0",
                 f"uid of the client: {uid}; sets listed on the empty server: {listed}")

def nm(base, i):
    """Set name so that the i-th set (i = 0..9) of the group is the i-th in the dir reply"""
    return f"{base}{i if order == 'asc' else 9 - i:07d}"

def add_group(base, kinds, entries = None):
    """Publish one set per item of `kinds` in the order of the dir reply:
    'R' readable (0644), 'U' unreadable (0600). entries[i] sets the entry
    length of the i-th set. Returns the names"""
    names = [ nm(base, i) for i in range(len(kinds)) ]
    for i, (n, k) in enumerate(zip(names, kinds)):
        perm = "0o644" if k == "R" else "0o600"
        ent = f", entry = {entries[i]}" if entries and entries[i] else ""
        pycmd(srv, f"add_set('{n}', 10, perm = {perm}{ent})")
    return names

# first in the listing
pycmd(srv, "unpublish_all()")
nn = add_group("F", "URR")
out = slow(cli7, "c.records()")
test.assert_test(39, out == f"[(0, {nn[1:]})]", f"expected [(0, {nn[1:]})]; got {out}")

# a full record, then an unreadable set, then a readable set
pycmd(srv, "unpublish_all()")
nn = add_group("H", "R")
e1 = int(pycmd(srv, f"entry_len('{nn[0]}')"))
pycmd(srv, "unpublish_all()")
nn = add_group("J", "RRUR", [0, LIMIT - e1, 0, 0])  # J0 and J1 total LIMIT
EXPECT(pycmd(srv, f"total({[nn[0], nn[1]]})"), str(LIMIT))
out = slow(cli7, "c.records()")
expect = f"[(1, {[nn[0], nn[1]]}), (0, {[nn[3]]})]"
test.assert_test(40, out == expect, f"expected {expect}; got {out}")

# last in the listing
pycmd(srv, "unpublish_all()")
nn = add_group("K", "RRU")
out = slow(cli7, "c.records()")
test.assert_test(41, out == f"[(0, {nn[:2]})]", f"expected [(0, {nn[:2]})]; got {out}")

# nothing readable
pycmd(srv, "unpublish_all()")
add_group("L", "UU")
out = slow(cli7, "c.records()")
test.assert_test(42, out == "[(0, [])]", f"expected [(0, [])]; got {out}")

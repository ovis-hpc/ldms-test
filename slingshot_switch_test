PORT_LIST = "slingshot_port_list" # the list metric in the set

# The counters in the `rfc_3635` set of fake_dump_counters
RFC_3635 = [
    "IfInDiscards", "IfInErrors", "IfInUnknownProtos", "IfOutDiscards",
    "IfOutErrors", "Dot3HCInPauseFrames", "Dot3HCOutPauseFrames",
    "IfHCInOctets", "IfHCInUcastPkts", "IfHCInMulticastPkts",
    "IfHCInBroadcastPkts", "IfHCOutOctets", "IfHCOutUcastPkts",
    "IfHCOutMulticastPkts", "IfHCOutBroadcastPkts",
]

#### spec #### -------------------------------------------------------
